{
  "name": "supernode",
  "version": "1.0.1",
  "description": "A comprehensive TypeScript utility library for Node.js applications",
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "test": "jest",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "typescript",
    "nodejs",
    "utilities",
    "game-development",
    "express",
    "database",
    "math",
    "string"
  ],
  "author": "Sayore Team",
  "license": "MIT",
  "type": "module",
  "main": "./dist/main.js",
  "module": "./dist/main.js",
  "types": "./dist/main.d.ts",
  "exports": {
    ".": {
      "import": "./dist/main.js",
      "types": "./dist/main.d.ts",
      "require": "./dist/main.cjs"
    },
    "./Base": {
      "import": "./dist/Base/index.js",
      "types": "./dist/Base/index.d.ts",
      "require": "./dist/Base/index.cjs"
    },
    "./String": {
      "import": "./dist/String/index.js",
      "types": "./dist/String/index.d.ts",
      "require": "./dist/String/index.cjs"
    },
    "./Game": {
      "import": "./dist/Game/index.js",
      "types": "./dist/Game/index.d.ts",
      "require": "./dist/Game/index.cjs"
    },
    "./Math": {
      "import": "./dist/Math/index.js",
      "types": "./dist/Math/index.d.ts",
      "require": "./dist/Math/index.cjs"
    },
    "./Packages": {
      "import": "./dist/Packages/index.js",
      "types": "./dist/Packages/index.d.ts",
      "require": "./dist/Packages/index.cjs"
    },
    "./Discord": {
      "import": "./dist/Discord/index.js",
      "types": "./dist/Discord/index.d.ts",
      "require": "./dist/Discord/index.cjs"
    },
    "./Express": {
      "import": "./dist/Express/index.js",
      "types": "./dist/Express/index.d.ts",
      "require": "./dist/Express/index.cjs"
    },
    "./Database": {
      "import": "./dist/Database/index.js",
      "types": "./dist/Database/index.d.ts",
      "require": "./dist/Database/index.cjs"
    },
    "./Time": {
      "import": "./dist/Time/index.js",
      "types": "./dist/Time/index.d.ts",
      "require": "./dist/Time/index.cjs"
    },
    "./System": {
      "import": "./dist/System/index.js",
      "types": "./dist/System/index.d.ts",
      "require": "./dist/System/index.cjs"
    },
    "./Debug": {
      "import": "./dist/Debug/index.js",
      "types": "./dist/Debug/index.d.ts",
      "require": "./dist/Debug/index.cjs"
    }
  },
  "files": [
    "dist/**/*",
    "README.md",
    "LICENSE",
    "package.json"
  ],
  "dependencies": {
    "chalk": "^4.1.2",
    "discord.js": "^13.17.1",
    "express": "^4.18.2",
    "fs-extra": "^11.1.0",
    "level": "^8.0.1",
    "level-ts": "^2.1.0",
    "lodash": "^4.17.21",
    "typescript": "^5.5.4",
    "yoga-layout-prebuilt": "^1.10.0"
  },
  "devDependencies": {
    "@types/chalk": "^0.4.31",
    "@types/express": "^4.17.25",
    "@types/fs-extra": "^11.0.4",
    "@types/jest": "^30.0.0",
    "@types/lodash": "^4.17.23",
    "@types/node": "^22.19.7",
    "@types/ws": "^8.18.1",
    "jest": "^30.2.0",
    "ts-jest": "^29.4.5"
  }
}
