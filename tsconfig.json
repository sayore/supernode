{
    "compilerOptions": {
        "module": "nodenext", 
        "target": "ES2022",
        "moduleResolution": "NodeNext",
        "lib": [
            "ES2023",
            "dom"
        ],
        "sourceMap": true,
        "declaration": true,
        "experimentalDecorators": true,
        "noEmit": false,
        "checkJs": false,
        "outDir": "./",
        "skipLibCheck": false,
        "strictNullChecks": true,
        "esModuleInterop": true
    },
    "include": [
        "./src/main.ts",
        "./src/test.ts"
    ],
    "exclude": [
        "node_modules"
    ],    
}